{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["pnpm-lock.yaml", "patches/*"],
  "globalEnv": [
    "CLOUDINARY_API_KEY",
    "CLOUDINARY_API_SECRET",
    "PUBLIC_CLOUDINARY_CLOUD_NAME",
    "PUBLIC_SITE_URL",
    "SITE_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": ["dist/**", ".next/**", "public/_pagefind/**"]
    },
    "test": {
      "outputs": ["dist/**"]
    },
    "types:check": {
      "dependsOn": [
        "^build"
      ],
      "outputs": ["dist/**", ".next/**"]
    },
    "dev": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    }
  }
}
